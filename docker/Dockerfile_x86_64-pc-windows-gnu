# openmc-pypi 用 mingw-w64 toolchain イメージ (x86_64-pc-windows-gnu)。
# Windows wheel も他ターゲットと同じく Linux 上の Docker クロスビルドで作る
# (github.com/lzpel/cadrum の Dockerfile_x86_64-pc-windows-gnu と同方式)。
# MSYS2 の CI 化は make の CURDIR が POSIX パス (/d/a/...) になり native cmake が
# 解釈できず破綻した (run 29983656072 で実測) ため廃止。windows-gnu は MSVC ABI
# 非依存なので native Windows runner は不要。
# ソースは実行時 bind-mount (project 非依存の toolchain イメージ。COPY しない)。
FROM ubuntu:24.04

# update-alternatives で posix スレッド版に固定 (cadrum と同じ)。OpenMC の std::thread は
# winpthreads 前提で、makefile の -static が libwinpthread ごと畳む (MSYS2 ホストで実証済み)。
# gfortran は NJOY 用。libgomp.a は gcc-mingw-w64 の posix 版に同梱され、makefile の
# `$(CXX) -print-file-name=libgomp.a` がそのまま解決する (OPENMP_LIB_NAME=gomp の既定通り)。
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git make patch file cmake python3 \
      gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 gfortran-mingw-w64-x86-64 \
 && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
 && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix \
 && update-alternatives --set x86_64-w64-mingw32-gfortran /usr/bin/x86_64-w64-mingw32-gfortran-posix \
 && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
 && rm -rf /var/lib/apt/lists/*

# toolchain.cmake (cmake >=3.21 は環境変数 CMAKE_TOOLCHAIN_FILE を読む → makefile 無改造で
# 全 cmake 呼び出しがクロス化する。darwin 版と同じ方式)。CMAKE_SYSTEM_NAME=Windows が肝:
# .dll/.exe 拡張子・WIN32 判定が makefile と上流 CMake の前提。
RUN { \
      echo "set(CMAKE_SYSTEM_NAME Windows)"; \
      echo "set(CMAKE_SYSTEM_PROCESSOR x86_64)"; \
      echo "set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)"; \
      echo "set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)"; \
      echo "set(CMAKE_Fortran_COMPILER x86_64-w64-mingw32-gfortran)"; \
      echo "set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)"; \
    } > /opt/toolchain.cmake

# makefile が読む環境契約 (これで環境依存が全部イメージに閉じる)
ENV CC=x86_64-w64-mingw32-gcc \
    CXX=x86_64-w64-mingw32-g++ \
    FC=x86_64-w64-mingw32-gfortran \
    CMAKE_TOOLCHAIN_FILE=/opt/toolchain.cmake
